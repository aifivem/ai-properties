{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-properties/data/properties.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "door": {
          "description": "Door: Stand at the front door, facing out: players leave here.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z",
            "heading"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "heading": {
              "type": "number"
            }
          }
        },
        "interior": {
          "description": "Interior: The id of an interior from the Interiors tab.",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "price": {
          "description": "Price",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "blip": {
          "description": "Show on the map while for sale: Owners always see their own properties.",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "door",
        "interior",
        "price",
        "blip"
      ]
    }
  },
  "additionalProperties": false
}
